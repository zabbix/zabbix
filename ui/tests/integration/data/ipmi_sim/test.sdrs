	event_reading_type_code	0x6f
	id_string		"EventOnly"
endsdr

# Signed (2s complement) threshold sensor, sensor number 18 - the raw 251 written by the test reads as -5.
sdr type 1
	sensor_owner_id		0x20
	sensor_owner_lun	0
	channel_number		0
	sensor_number		18
	entity_id		system_board
	entity_instance		1
